def array_sorting_menu():
    print("\nARRAY SORTING VIA THREAD")
    
    def sort_array():
        array = input("Enter a list of numbers separated by spaces to sort: ")
        try:
            nums = [int(x) for x in array.split()]
            nums.sort()
            print(f"Sorted Array: {nums}")
        except ValueError:
            print("Invalid input. Please enter numbers only.")

    # Thread for sorting
    thread = threading.Thread(target=sort_array)
    thread.start()
    thread.join()


# Matrix Operations Menu
def matrix_operations_menu():
    while True:
        print("\nMATRIX OPERATIONS MENU")
        print("1. Add Matrices")
        print("2. Subtract Matrices")
        print("3. Multiply Matrices")
        print("4. Divide Matrices")
        print("5. Back to Main Menu")
        
        choice = input("Choose an operation (1-5): ")
        
        if choice in ["1", "2", "3", "4"]:
            rows = int(input("Enter number of rows for matrices: "))
            cols = int(input("Enter number of columns for matrices: "))
            
            # Create random matrices
            matrix_a = [[random.randint(1, 10) for _ in range(cols)] for _ in range(rows)]
            matrix_b = [[random.randint(1, 10) for _ in range(cols)] for _ in range(rows)]

            print("\nMatrix A:")
            for row in matrix_a:
                print(row)

            print("\nMatrix B:")
            for row in matrix_b:
                print(row)

            # Choose a thread for operation
            if choice == "1":
                thread = threading.Thread(target=add_matrices, args=(matrix_a, matrix_b))
            elif choice == "2":
                thread = threading.Thread(target=subtract_matrices, args=(matrix_a, matrix_b))
            elif choice == "3":
                thread = threading.Thread(target=multiply_matrices, args=(matrix_a, matrix_b))
            elif choice == "4":
                thread = threading.Thread(target=divide_matrices, args=(matrix_a, matrix_b))

            thread.start()
            thread.join()
        elif choice == "5":
            break
        else:
            print("Invalid choice! Please try again.")


# Matrix Operations
def add_matrices(matrix_a, matrix_b):
    result = [[matrix_a[i][j] + matrix_b[i][j] for j in range(len(matrix_a[0]))] for i in range(len(matrix_a))]
    print("\nAddition Result:")
    for row in result:
        print(row)


def subtract_matrices(matrix_a, matrix_b):
    result = [[matrix_a[i][j] - matrix_b[i][j] for j in range(len(matrix_a[0]))] for i in range(len(matrix_a))]
    print("\nSubtraction Result:")
    for row in result:
        print(row)


def multiply_matrices(matrix_a, matrix_b):
    result = [[sum(matrix_a[i][k] * matrix_b[k][j] for k in range(len(matrix_b))) for j in range(len(matrix_b[0]))] for i in range(len(matrix_a))]
    print("\nMultiplication Result:")
    for row in result:
        print(row)


def divide_matrices(matrix_a, matrix_b):
    try:
        result = [[matrix_a[i][j] / matrix_b[i][j] if matrix_b[i][j] != 0 else float('inf') for j in range(len(matrix_a[0]))] for i in range(len(matrix_a))]
        print("\nDivision Result:")
        for row in result:
            print(row)
    except ZeroDivisionError:
        print("\nDivision Error: Division by zero encountered in matrix operation.")


# Backup Menu
def backup_menu():
    while True:
        print("\nBACKUP MENU")
        print("1. Create a Backup")
        print("2. Restore a Backup")
        print("3. Back to Main Menu")
        
        choice = int(input("Enter your choice (1-3): "))
        
        if choice == 1:
            path= input("Enter the directory/file to backup: ")
            destination = input("Enter the backup destination \nC:\\backup\\backup.zip): ")
            try:
                os.system(f"powershell Compress-Archive -Path {path} -DestinationPath {destination}")
                print(f"Backup successfully created at {destination}.")
            except Exception as e:
                print(f"Error creating backup: {e}")
        elif choice == 2:
            backup_file = input("Enter the backup file path: ")
            restore_location = input("Enter the directory to restore to: ")
            try:
                os.system(f"powershell Expand-Archive -Path {backup_file} -DestinationPath {restore_location}")
                print(f"Backup restored to {restore_location}.")
            except Exception as e:
                print(f"Error restoring backup:{e} ")       
        elif choice == 3:
            break
        else:
            print("Invalid choice! Please try again.")


