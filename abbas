# Service Management Menu
def service_management_menu():
    global created_files
    global created_folders
    while True:
        print("\nFILE AND FOLDER MANAGEMENT")
        print("1. Create a File")
        print("2. Create a Folder")
        print("3. Delete a File")
        print("4. Delete a Folder")
        print("5. Show All Files and Folders")
        print("6. Write to a File")
        print("7. Set File Permissions")
        print("8. Back to Main Menu")
        
        choice = input("Enter your choice (1-8): ").strip()
        
        if choice == "1":
            file_name = input("Enter the file name to create (e.g., file.txt): ")
            folder_name = input("Enter the folder name to create the file in: ")
            if folder_name not in created_folders:
                os.makedirs(folder_name, exist_ok=True)
                created_folders[folder_name] = []
            file_path = os.path.join(folder_name, file_name)
            with open(file_path, 'w') as file:
                file.write("")
            created_files.append((file_name, folder_name))
            print(f"File '{file_name}' created in '{folder_name}'.")
        
        elif choice == "2":
            folder_name = input("Enter the folder name to create: ")
            os.makedirs(folder_name, exist_ok=True)
            created_folders[folder_name] = []
            print(f"Folder '{folder_name}' created.")
        
        elif choice == "3":
            file_name = input("Enter the file name to delete: ")
            folder_name = input("Enter folder name: ")
            file_path = os.path.join(folder_name, file_name)
            if os.path.exists(file_path):
                os.remove(file_path)
                created_files = [f for f in created_files if f != (file_name, folder_name)]
                print("Deleted the file successfully.")
            else:
                print("File does not exist.")
        
        elif choice == "4":
            folder_name = input("Enter the folder name to delete: ")
            if os.path.exists(folder_name):
                os.rmdir(folder_name)
                created_folders.pop(folder_name, None)
                print(f"Folder '{folder_name}' deleted.")
            else:
                print("Folder does not exist.")
        
        elif choice == "5":
            print("\nShowing all created files and folders:")
            if not created_files and not created_folders:
                print("No files or folders have been created yet.")
            else:
                if created_files:
                    print("Files:")
                    for file_name, folder_name in created_files:
                        print(f"  - {file_name} (in {folder_name})")
                if created_folders:
                    print("Folders:")
                    for folder_name in created_folders.keys():
                        print(f"  - {folder_name}")
        
        elif choice == "6":
            folder_name = input("Enter the folder name of the file: ")
            file_name = input("Enter the file name to write to: ")
            file_path = os.path.join(folder_name, file_name)
            if os.path.exists(file_path):
                content = input("Enter content to write to the file: ")
                with open(file_path, 'a') as file:
                    file.write(content)
                print("Content written to the file.")
            else:
                print("File does not exist.")
        
        elif choice == "7":
            folder_name = input("Enter the folder name of the file: ")
            file_name = input("Enter the file name to change permissions: ")
            file_path = os.path.join(folder_name, file_name)
            if os.path.exists(file_path):
                print("\nSet permissions:")
                print("1. Read-only")
                print("2. Write-only")
                print("3. Execute-only")
                print("4. Read and Write")
                print("5. Read, Write, and Execute")
                perm_choice = input("Enter your choice (1-5): ")

                if perm_choice == "1":
                    os.chmod(file_path, stat.S_IREAD)
                    print("Set to Read-only.")
                elif perm_choice == "2":
                    os.chmod(file_path, stat.S_IWRITE)
                    print("Set to Write-only.")
                elif perm_choice == "3":
                    os.chmod(file_path, stat.S_IEXEC)
                    print("Set to Execute-only.")
                elif perm_choice == "4":
                    os.chmod(file_path, stat.S_IREAD | stat.S_IWRITE)
                    print("Set to Read and Write.")
                elif perm_choice == "5":
                    os.chmod(file_path, stat.S_IREAD | stat.S_IWRITE | stat.S_IEXEC)
                    print("Set to Read, Write, and Execute.")
                else:
                    print("Invalid choice for permissions.")
            else:
                print("File does not exist.")
        
        elif choice == "8":
            break
        
        else:
            print("Invalid choice! Please try again.")



# Process Management Menu
def process_management_menu():
